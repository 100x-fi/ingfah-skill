# Copy to .env and fill in. .env is gitignored; never commit a key.
# Any OpenAI-compatible provider works; these defaults use OpenRouter.
OPENROUTER_API_KEY=sk-or-v1-...
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# The model Ingfah voice agents run on
AGENT_MODEL=google/gemma-4-26b-a4b-it
# The model the post-call disposition classifier runs on
DISPOSITION_MODEL=google/gemini-3.1-flash-lite
